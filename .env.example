# =============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN HỎA DIỆM CÁC (FRONTEND CLIENT)
# =============================================================================

# Base URL của Backend Spring Boot REST API
VITE_API_URL=http://localhost:8080/api/v1

# Endpoint kết nối WebSocket STOMP
VITE_WS_URL=http://localhost:8080/ws

# Thời gian cooldown chống spam chuông gọi phục vụ (tính bằng giây, theo QĐ10)
VITE_CALL_STAFF_COOLDOWN=30
